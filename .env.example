# Optional. Defaults to development when omitted.
APP_ENV=

# Required. Must identify the authorized sandbox.
TARGET_ENV=

# Required HTTPS base URL. Do not include credentials, query, or fragment.
TARGET_SALESFORCE_BASE_URL=

# Required. Must identify the authorized Salesforce organization.
TARGET_SALESFORCE_ORG_ID=

# Required postgres/postgresql URL with a non-empty password.
DATABASE_URL=

# Required HTTPS URL. Do not include credentials, query, or fragment.
QSTASH_URL=

# Orchestration remains off unless explicitly enabled.
ORCHESTRATION_ENABLED=false

# Fake OAuth token endpoint for dev-only Named Credential redirection.
# Requires ORCHESTRATION_ENABLED=true and GRAPHQL_CALLBACK_SHARED_SECRET with at
# least 32 characters. While enabled, any public request to
# /api/ms-clientes/token receives that secret back as access_token.
AZURE_TOKEN_SIMULATOR_ENABLED=false

# Fake PAC credito callback endpoint for the fire-and-forget Azure Service Bus redirect.
# Requires ORCHESTRATION_ENABLED=true.
PAC_CREDITO_CALLBACK_ENABLED=false

# Internal GraphQL callback remains off by default.
# Requires ORCHESTRATION_ENABLED=true.
GRAPHQL_CALLBACK_ENABLED=false

# Optional. Defaults to SHARED_SECRET.
# SHARED_SECRET expects a dedicated simulator secret below.
# AZURE_BEARER_STRUCTURAL accepts only structurally valid Azure AD JWTs
# (shape/exp/iss), without JWKS signature verification.
GRAPHQL_CALLBACK_AUTH_MODE=

# Real Salesforce dispatch remains off by default. When false, the fake target is used.
SALESFORCE_DISPATCH_ENABLED=false

# Enables durable setup before QStash and verify/cleanup after dispatch.
# Off by default; requires ORCHESTRATION_ENABLED and SALESFORCE_DISPATCH_ENABLED.
SALESFORCE_TEST_DATA_ENABLED=false

# Required only when ORCHESTRATION_ENABLED=true. Keep all values server-only.
SIMULATOR_ADMIN_API_KEY=
# Required when AZURE_TOKEN_SIMULATOR_ENABLED=true, and also when
# GRAPHQL_CALLBACK_ENABLED=true with GRAPHQL_CALLBACK_AUTH_MODE omitted or set
# to SHARED_SECRET.
GRAPHQL_CALLBACK_SHARED_SECRET=
IDEMPOTENCY_HASH_PEPPER=
PUBLIC_APP_BASE_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Required only when SALESFORCE_DISPATCH_ENABLED=true. Test data reuses this OAuth.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_TOKEN_URL=
