{
  "name": "ms-clientes-simulator",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:scenarios && npm run validate:fixtures",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:scenarios": "vitest run src/scenarios/catalog.validation.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:migrate:check": "drizzle-kit check",
    "sanitize:export": "node scripts/sanitize-export.ts",
    "validate:fixtures": "node scripts/validate-fixtures.ts",
    "stress:o10": "node scripts/run-stress-o10-concurrent-events.cjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/qstash": "^2.11.3",
    "drizzle-orm": "^0.45.2",
    "graphql": "^17.0.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@electric-sql/pglite": "^0.5.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
